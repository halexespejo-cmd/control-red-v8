# App
DEBUG=True

# Network
NETWORK_INTERFACE=wlan0
SCAN_INTERVAL=15
ARP_INTERVAL=2

# Database (SQLite para desarrollo, PostgreSQL para producción)
DATABASE_URL=sqlite+aiosqlite:///./control_red.db
# Para producción usar PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/control_red
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Allowed Origins (separar con comas)
ALLOWED_ORIGINS=https://halexespejo-cmd.github.io,http://localhost:5173

# Logging
LOG_LEVEL=INFO

# Sentry Error Tracking (opcional - obtener DSN en https://sentry.io)
SENTRY_DSN=

# Redis Cache (opcional - para mejor performance)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Celery Background Tasks
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
