# App
DEBUG=True

# Network
NETWORK_INTERFACE=wlan0
SCAN_INTERVAL=15
ARP_INTERVAL=2

# Database
DATABASE_URL=sqlite+aiosqlite:///./control_red.db

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Allowed Origins (separar con comas)
ALLOWED_ORIGINS=https://halexespejo-cmd.github.io,http://localhost:5173

# Logging
LOG_LEVEL=INFO

# Sentry Error Tracking (opcional - obtener DSN en https://sentry.io)
SENTRY_DSN=
